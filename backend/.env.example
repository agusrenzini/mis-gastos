# Copiá este archivo como "backend/.env" y completá los valores.
# (scripts/crear-base.ps1 lo genera automáticamente.)
# El archivo .env NO se sube a git.

DATABASE_URL=jdbc:postgresql://localhost:5432/mis_gastos
DB_USERNAME=mis_gastos
DB_PASSWORD=cambiame

# Opcional en tu PC, recomendada al publicar: clave larga al azar para que la sesión
# siga abierta aunque el servidor se reinicie.
# REMEMBER_ME_KEY=una-clave-larga-al-azar
